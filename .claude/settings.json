{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-commit-push-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Prüfe auf git commit/push …"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/secret-file-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Prüfe auf Zugriff auf sensible Dateien …"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/secret-file-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Prüfe auf Zugriff auf sensible Dateien …"
          }
        ]
      }
    ]
  }
}
